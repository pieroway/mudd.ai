# Copy to .env.production and replace every change-me value.
PUBLIC_URL=https://localhost:8443
CADDY_HOST=localhost
HTTPS_PORT=8443
POSTGRES_USER=muduser
POSTGRES_PASSWORD=change-me-use-a-long-random-secret
POSTGRES_DB=muddb
DATABASE_URL=postgresql+asyncpg://muduser:change-me-use-a-long-random-secret@postgres:5432/muddb

AI_PROVIDER=fake
LOG_LEVEL=INFO
MAX_COMMAND_BYTES=4096
COMMAND_RATE_LIMIT=10
COMMAND_RATE_WINDOW_SECONDS=1
MAX_WEBSOCKET_CONNECTIONS=250
CONNECTION_ATTEMPT_LIMIT=60
CONNECTION_ATTEMPT_WINDOW_SECONDS=60
MAX_TRACKED_CLIENT_ADDRESSES=10000
OUTBOUND_SEND_TIMEOUT_SECONDS=2
