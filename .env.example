# Application
APP_ENV=development
LOG_LEVEL=INFO
# Exact, comma-separated browser origins allowed by HTTP CORS and WebSockets.
# Native WebSocket clients may omit Origin; authentication POSTs require it.
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_COMMAND_BYTES=4096
COMMAND_RATE_LIMIT=10
COMMAND_RATE_WINDOW_SECONDS=1
MAX_WEBSOCKET_CONNECTIONS=250
CONNECTION_ATTEMPT_LIMIT=60
CONNECTION_ATTEMPT_WINDOW_SECONDS=60
MAX_TRACKED_CLIENT_ADDRESSES=10000
OUTBOUND_SEND_TIMEOUT_SECONDS=2

# Database
DATABASE_URL=postgresql+asyncpg://muduser:mudpass@postgres:5432/muddb

# Redis
REDIS_URL=redis://redis:6379

# Authentication
AUTH_SESSION_SECONDS=86400
AUTH_ATTEMPT_LIMIT=20
AUTH_ATTEMPT_WINDOW_SECONDS=60

# AI Provider Configuration
AI_PROVIDER=fake
AI_MODEL=
AI_COMMAND_TIMEOUT_SECONDS=5
AI_COMMAND_MAX_INPUT_BYTES=4096
AI_COMMAND_MAX_OUTPUT_TOKENS=512
AI_COMMAND_MAX_REQUESTS=100
AI_COMMAND_MAX_CONCURRENT=2
AI_DAILY_REQUEST_LIMIT=20
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Feature Flags
AI_NARRATION_ENABLED=false
AI_COMMAND_INTERPRETATION_ENABLED=false
AI_WORLD_GENERATION_ENABLED=false

# Frontend
VITE_API_URL=http://localhost:8000
