# Application
APP_ENV=development
LOG_LEVEL=INFO
# Exact, comma-separated browser origins allowed by HTTP CORS and WebSockets.
# Native clients that omit the Origin header remain supported.
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_COMMAND_BYTES=4096
COMMAND_RATE_LIMIT=10
COMMAND_RATE_WINDOW_SECONDS=1
MAX_WEBSOCKET_CONNECTIONS=250
CONNECTION_ATTEMPT_LIMIT=60
CONNECTION_ATTEMPT_WINDOW_SECONDS=60
OUTBOUND_SEND_TIMEOUT_SECONDS=2

# Database
DATABASE_URL=postgresql+asyncpg://muduser:mudpass@postgres:5432/muddb

# Redis
REDIS_URL=redis://redis:6379

# AI Provider Configuration
AI_PROVIDER=fake
AI_MODEL=claude-3-haiku
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Feature Flags
AI_NARRATION_ENABLED=false
AI_COMMAND_INTERPRETATION_ENABLED=false
AI_WORLD_GENERATION_ENABLED=false

# Frontend
VITE_API_URL=http://localhost:8000
